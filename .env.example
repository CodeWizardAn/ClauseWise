# ClauseWise — example configuration.
# Copy to .env and adjust. Never commit a real .env.
#
# Secrets belong here and on the server only — never in the browser bundle,
# never in a URL, and never with a hardcoded fallback in code. A missing key
# must fail loudly or degrade visibly, never silently.

# Where the Next.js app reaches the Python extraction sidecar.
#   docker compose : http://engine:8000  (set for you in docker-compose.yml)
#   running locally: http://127.0.0.1:8000
ENGINE_URL=http://127.0.0.1:8000

# Largest document accepted, in bytes. Default 10 MiB.
# Keep the web app and the engine in step.
MAX_UPLOAD_BYTES=10485760

# Host port for the web app when using docker compose.
WEB_PORT=3000

# --- Phase 3: the AI layer ---------------------------------------------------
# Both are optional. With neither set, the app still runs end to end: clause
# segmentation, the affordability verdict and the Omission Radar are pure code,
# and the AI features show an honest "unavailable" notice instead of failing.
#
# Groq is the primary provider, Gemini the fallback.
#   Groq keys:   https://console.groq.com/keys
#   Gemini keys: https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional model overrides. Leave unset to use the verified defaults in code.
# GROQ_MODEL=
# GEMINI_MODEL=
